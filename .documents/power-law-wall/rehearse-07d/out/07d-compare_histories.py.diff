+def flatten(d, prefix=""):
+    """extra_data's margins, sub-key by sub-key, a nested record's fields under dotted names."""
+    out = {}
+    for k, v in d.items():
+        if isinstance(v, dict):
+            out.update(flatten(v, f"{prefix}{k}."))
+        else:
+            out[f"{prefix}{k}"] = v
+    return out
