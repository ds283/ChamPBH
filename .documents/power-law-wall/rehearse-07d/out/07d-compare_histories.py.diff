+class KexTally:
+    """--across-k-ex: P114's columns, reported per (table.column, group), not failed."""
 
+    def __init__(self):
+        self.cols = defaultdict(lambda: defaultdict(dict))
 
+    def record(self, table, col, group, tag, a, b):
+        s = self.cols[f"{table}.{col}"][group]
+        if not s:
+            s.update(
+                compared=0,
+                differ=0,
+                up=None,
+                down=None,
+                nulls=0,
+                transitions=defaultdict(int),
+                first=None,
+            )
+        s["compared"] += 1
+        if same(a, b):
+            return
+        s["differ"] += 1
+        if s["first"] is None:
+            s["first"] = f"{tag}: A {a!r} B {b!r}"
+        if a is None or b is None:
+            s["nulls"] += 1
+            s["transitions"][(repr(a), repr(b))] += 1
+            return
+        if (
+            isinstance(a, (int, float))
+            and isinstance(b, (int, float))
+            and not (isinstance(a, bool) or isinstance(b, bool))
+        ):
+            d = float(b) - float(a)
+            if d > 0 and (s["up"] is None or d > s["up"][0]):
+                s["up"] = (d, tag, a, b)
+            if d < 0 and (s["down"] is None or d < s["down"][0]):
+                s["down"] = (d, tag, a, b)
+            return
+        s["transitions"][(repr(a), repr(b))] += 1
+
+    def report(self):
+        print(
+            "k_ex columns (P114), per column and group (potential, n, B's drain model):"
+        )
+        if not self.cols:
+            print("  (none compared)")
+        for name in sorted(self.cols):
+            for group in sorted(self.cols[name], key=str):
+                s = self.cols[name][group]
+                pot, n, model = group
+                line = f"  {name} [{pot} n={n} {model}]: compared {s['compared']}, differ {s['differ']}"
+                if s["up"] is not None:
+                    d, tg, a, b = s["up"]
+                    line += f"; largest rise {d:+.6g} ({a!r} -> {b!r} at {tg})"
+                if s["down"] is not None:
+                    d, tg, a, b = s["down"]
+                    line += f"; largest fall {d:+.6g} ({a!r} -> {b!r} at {tg})"
+                if s["nulls"]:
+                    line += f"; NULL on one side {s['nulls']}"
+                if s["transitions"]:
+                    line += "; transitions " + ", ".join(
+                        f"{x} -> {y}: {k}"
+                        for (x, y), k in sorted(s["transitions"].items())
+                    )
+                print(line)
+
+    def moved(self):
+        """(column, group, count, largest |change|) for each column and group in which a value moved."""
+        out = []
+        for name in sorted(self.cols):
+            for group in sorted(self.cols[name], key=str):
+                s = self.cols[name][group]
+                if s["differ"]:
+                    big = max(
+                        [abs(x[0]) for x in (s["up"], s["down"]) if x is not None],
+                        default=None,
+                    )
+                    out.append((name, group, s["differ"], s["compared"], big))
+        return out
+
