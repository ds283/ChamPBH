+    not_n2 = [
+        f for f in extra if not any(part.endswith("_n=2") for part in Path(f).parts)
+    ]
+    print(
+        f"B's files not in A under an n = 2 path: {len(extra) - len(not_n2)}; elsewhere: {len(not_n2)}"
+    )
+    for f in not_n2:
